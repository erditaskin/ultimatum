{
  "name": "ultimatum",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "node": "^22.23.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "format": "prettier --write src tests scripts docs *.json README.md",
    "lint": "expo lint",
    "benchmark:karbasan": "node --import tsx scripts/benchmark-karbasan.ts",
    "verify:assets": "node --import tsx scripts/verify-karbasan-assets.ts"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
